    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="21"
        android:translateY="21"
        android:scaleX="0.66"
        android:scaleY="0.66">
        <path
            android:pathData="M38.31,45.52 L32,35 L50,5 L68,35 L50,65 L43.69,54.48"
            android:strokeColor="@color/launcher_foreground"
            android:strokeWidth="5.5"
            android:strokeLineJoin="miter"
            android:strokeMiterLimit="10" />
        <path
            android:pathData="M61.69,54.48 L68,65 L50,95 L32,65 L50,35 L56.31,45.52"
            android:strokeColor="@color/launcher_foreground"
            android:strokeWidth="5.5"
