# Where the Obey API lives. Defaults to http://localhost:3000.
VITE_API_URL=http://localhost:3000

# Firebase web config (Project settings -> Your apps -> Web app). Leave these empty to use dev
# sign-in, which sends `X-Dev-User: <uuid>` and only works against an API started with DEV_AUTH=1.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Web Push certificate (Project settings -> Cloud Messaging -> Web Push certificates -> Key pair).
# Push registration is skipped unless this and the Firebase config above are set.
VITE_FIREBASE_VAPID_KEY=
